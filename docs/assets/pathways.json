  },
  "p2": {
   "title": "Run and understand",
   "competency": "Understand data",
   "can_do": "You can say what a dataset holds and where it is incomplete or doubtful, before you compute with it."
  },
  "p3": {
   "title": "Query and connect",
   "competency": "Query and connect",
   "can_do": "You can ask questions across files and tables, and show that combining them did what you meant."
  },
  "p4": {
   "title": "Explore and verify",
   "competency": "Explore with AI and verify",
   "can_do": "You can work with an AI assistant and test what it tells you against the data."
  },
  "p5": {
   "title": "Preserve and share",
   "competency": "Preserve and share",
   "can_do": "You can leave work that someone else can find, understand, and run again."
  }
 },
